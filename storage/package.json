{
  "name": "@dsas/storage",
  "version": "0.1.0",
  "type": "module",
  "description": "Storage layer for DSAS prototype: pluggable provider drivers (pinata/web3storage/local/irys), chatlog parsers, and NFT metadata builder.",
  "main": "dist/storage/src/index.js",
  "types": "dist/storage/src/index.d.ts",
  "exports": {
    ".": "./dist/storage/src/index.js",
    "./providers": "./dist/storage/src/providers/index.js",
    "./chatlog": "./dist/storage/src/chatlog/index.js",
    "./metadata": "./dist/storage/src/metadata_builder.js",
    "./uri": "./dist/storage/src/uri.js",
    "./encryption": "./dist/storage/src/encryption.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "form-data": "^4.0.0",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.12.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
