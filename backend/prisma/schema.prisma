// DSAS backend Prisma schema.
// Postgres-backed off-chain cache for ERC-721 + ERC-6150 tablets,
// plus training-job lifecycle and SIWE session storage.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum JobStatus {
  QUEUED
  RUNNING
  UPLOADED
  DONE
  FAILED
}

model Tablet {
  tokenId       BigInt        @id
  owner         String
  parentTokenId BigInt?
  tokenURI      String
  artifactURI   String?
  metadataJson  Json?
  syncedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  trainingJobs  TrainingJob[]

  @@index([owner])
  @@index([parentTokenId])
}

model TrainingJob {
  id          String    @id @default(cuid())
  tokenId     BigInt
  status      JobStatus @default(QUEUED)
  artifactCid String?
  artifactURI String?
  txHash      String?
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tablet      Tablet    @relation(fields: [tokenId], references: [tokenId])

  @@index([tokenId])
  @@index([status])
}

model User {
  address   String   @id // checksummed wallet address
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())
}

model Session {
  nonce     String   @id
  address   String
  issuedAt  DateTime @default(now())
  expiresAt DateTime
  used      Boolean  @default(false)

  @@index([address])
  @@index([expiresAt])
}

/// 線上靈堂 (/baibai) 的留言。任何人都能留(不要求 SIWE 登入),只在
/// 已連線錢包時自動把地址綁進來,讓家屬之後能看出哪些是自家人留的。
model Tribute {
  id           String   @id @default(cuid())
  tokenId      BigInt
  fromAddress  String?  // 留言者錢包地址(可選);未連線錢包時為 null
  fromName     String?  // 顯示用名稱(可選);沒填就顯示「匿名訪客」
  message      String   @db.Text
  createdAt    DateTime @default(now())

  @@index([tokenId])
  @@index([createdAt])
}
