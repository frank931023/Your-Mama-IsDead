// DSAS backend Prisma schema.
// Postgres-backed off-chain cache for ERC-721 + ERC-6150 tablets,
// plus training-job lifecycle and SIWE session storage.

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum JobStatus {
  QUEUED
  RUNNING
  UPLOADED
  DONE
  FAILED
}

/// 哀悼版 story 的審核狀態。
///   PENDING  訪客/屋主剛投稿,待屋主策展
///   APPROVED 屋主核可,可進下一次上鏈批次
///   REJECTED 屋主隱藏 (留在 DB,永不公開、永不上鏈)
///   ONCHAIN  已被某次 setTokenURI 快照收錄 (dedup guard)
enum StoryStatus {
  PENDING
  APPROVED
  REJECTED
  ONCHAIN
}

model Tablet {
  tokenId       BigInt        @id
  owner         String
  parentTokenId BigInt?
  tokenURI      String
  artifactURI   String?
  metadataJson  Json?
  /// 是否公開列在公開總覽 / baibai。每次 syncOnce 從 metadata.dsas.public 同步,
  /// 用真欄 (而非每次讀快取 JSON) 才能讓 /registry/public 直接用 query 過濾。
  public        Boolean       @default(false)
  syncedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  trainingJobs  TrainingJob[]

  @@index([owner])
  @@index([parentTokenId])
  @@index([public])
}

model TrainingJob {
  id          String    @id @default(cuid())
  tokenId     BigInt
  status      JobStatus @default(QUEUED)
  artifactCid String?
  artifactURI String?
  txHash      String?
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tablet      Tablet    @relation(fields: [tokenId], references: [tokenId])

  @@index([tokenId])
  @@index([status])
}

model User {
  address   String   @id // checksummed wallet address
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())
}

model Session {
  nonce     String   @id
  address   String
  issuedAt  DateTime @default(now())
  expiresAt DateTime
  used      Boolean  @default(false)

  @@index([address])
  @@index([expiresAt])
}

/// 線上靈堂 (/baibai) 的留言。任何人都能留(不要求 SIWE 登入),只在
/// 已連線錢包時自動把地址綁進來,讓家屬之後能看出哪些是自家人留的。
model Tribute {
  id           String   @id @default(cuid())
  tokenId      BigInt
  fromAddress  String?  // 留言者錢包地址(可選);未連線錢包時為 null
  fromName     String?  // 顯示用名稱(可選);沒填就顯示「匿名訪客」
  message      String   @db.Text
  /// 供品小物類型:incense(香) / lotus(紙蓮花) / fruit(鮮果) / tea(茶) / candle(燭) / note(純留言)
  kind         String   @default("note")
  createdAt    DateTime @default(now())

  @@index([tokenId])
  @@index([createdAt])
}

/// 哀悼版的一段回憶 (story)。屋主與訪客都能投稿 (不要求 SIWE 登入)。
///
/// 投稿時內容會先 pin 到 IPFS 拿 contentCid (不可竄改),狀態預設 PENDING,
/// 屋主審核 (PATCH→APPROVED/REJECTED) 後才公開可見。屋主在塔位頁把 APPROVED
/// 的 stories 合併進 metadata 簽 setTokenURI 上鏈,成功後 commit 把它們翻成
/// ONCHAIN (避免重複批次)。鏈上 dsas.stories[] 是屋主策展快照,這裡才是即時流。
model MemorialStory {
  id            String      @id @default(cuid())
  tokenId       BigInt
  title         String
  body          String      @db.Text
  authorName    String? // 顯示名 (可選)
  authorAddress String? // 投稿時若有連錢包則記 checksummed 地址
  photoUri      String? // 可選單張照片的 ipfs:// uri (前端先上傳好才傳進來)
  refDate       String? // 回憶所指日期 (可選, ISO)
  contentCid    String // pin 的 story JSON CID — 不可竄改證明
  status        StoryStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([tokenId])
  @@index([tokenId, status])
  @@index([createdAt])
}

/// RAG 記憶片段:逝者對話紀錄 (chatlogs) 切片後的向量索引。
/// 每輪對話用使用者問題 embedding 對這裡做相似度檢索,取 top-k 拼進 persona prompt,
/// 讓回答有逝者本人真實語料佐證 (而不只是 LLM 根據 metadata 腦補)。
///
/// embedding 是 multilingual-e5-small 的 384 維向量。Prisma 不原生支援 pgvector,
/// 故用 Unsupported 宣告該欄;寫入 / 相似度查詢都走 $executeRaw / $queryRaw。
/// sourceUri = 來源 chatlog 的 ipfs uri;重建索引時先依 tokenId 刪舊再插新。
model MemoryChunk {
  id         String                      @id @default(cuid())
  tokenId    BigInt
  text       String                      @db.Text
  /// 來源 chatlog 的 ipfs uri (重建 / 除錯用)
  sourceUri  String
  /// 來源平台 (line/telegram/...) — 檢索結果標註用
  platform   String?
  /// 片段裡的發話者 (通常是逝者本人) — 過濾用
  speaker    String?
  embedding  Unsupported("vector(384)")?
  createdAt  DateTime                    @default(now())

  @@index([tokenId])
}
