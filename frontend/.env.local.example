# Target chain id (11155111 = Sepolia, 84532 = Base Sepolia)
NEXT_PUBLIC_CHAIN_ID=11155111

# Deployed DigitalTablet contract address
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Backend (BFF) base URL — strips trailing slash
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# WalletConnect Cloud project id (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# IPFS HTTP gateway used to render ipfs:// URIs in <img>/<video>
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
