# Only needed when running the frontend on the host (docker compose reads the repo-root .env).

# Target chain id (11155111 = Sepolia, 84532 = Base Sepolia)
NEXT_PUBLIC_CHAIN_ID=11155111

# Deployed DigitalTablet contract address
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Backend (BFF) base URL — strips trailing slash
NEXT_PUBLIC_BACKEND_URL=http://localhost:14000

# WalletConnect Cloud project id (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Gateways used to render ar:// and ipfs:// URIs in <img>/<video>
NEXT_PUBLIC_ARWEAVE_GATEWAY=https://arweave.net/
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Private-asset encryption: none | legacy (Lit threshold network) | chipotle (Lit Action)
NEXT_PUBLIC_LIT_MODE=none
NEXT_PUBLIC_LIT_LEGACY_NETWORK=naga-dev
NEXT_PUBLIC_LIT_CHIPOTLE_API_URL=https://api.chipotle.litprotocol.com
# Filled by backend/scripts/lit-chipotle-setup.ts
NEXT_PUBLIC_LIT_CHIPOTLE_ACTION_CID=
NEXT_PUBLIC_LIT_CHIPOTLE_ACTION_PUBKEY=
NEXT_PUBLIC_LIT_CHIPOTLE_USAGE_KEY=
